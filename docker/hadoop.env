# =====================================================================
#  hadoop.env - Configuracion comun de los contenedores de Hadoop
#  (namenode, datanode1, datanode2, resourcemanager y nodemanager)
#
#  QUE ES: un archivo de "variables de entorno" que el docker-compose.yml
#  carga en cada contenedor de Hadoop (env_file: ./docker/hadoop.env).
#  Al arrancar, el script de entrada de las imagenes bde2020 convierte cada
#  variable en una propiedad de los archivos de configuracion de Hadoop:
#
#     CORE_CONF_...    -> core-site.xml   (ajustes generales)
#     HDFS_CONF_...    -> hdfs-site.xml   (sistema de archivos HDFS)
#     YARN_CONF_...    -> yarn-site.xml   (gestor de recursos YARN)
#     MAPRED_CONF_...  -> mapred-site.xml (MapReduce)
#
#  En el nombre, "_" se convierte en "." y "___" en "-". Ejemplo:
#     YARN_CONF_yarn_nodemanager_resource_memory___mb=2048
#     -> propiedad yarn.nodemanager.resource.memory-mb = 2048
#
#  ORIGEN: el hadoop.env del profesor (entorno docker-hadoop de clase).
#  CAMBIOS (17 oct 2026, mini-paso 1.4e): marcados con "# CAMBIO:" justo
#  encima de cada linea, indicando el valor original. Motivo comun: el
#  original reserva 16 GB y 8 nucleos para YARN y pide tareas de hasta
#  8 GB, imposible con los ~8 GB de Docker del portatil (ver seccion 10
#  del documento explicativo).
#
#  REGLAS DE ESTE ARCHIVO: los comentarios deben ocupar lineas enteras
#  (nada de comentarios al final de una linea con valor) y van sin tildes
#  para evitar problemas de codificacion dentro de los contenedores.
# =====================================================================


# ---------------------------------------------------------------------
# CORE (core-site.xml): ajustes generales de Hadoop
# ---------------------------------------------------------------------

# Direccion "por defecto" del sistema de archivos: cuando un programa pide
# una ruta como /raw/steam, Hadoop entiende hdfs://namenode:9000/raw/steam.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
# Usuario con el que se muestran los archivos en las webs de Hadoop (root).
CORE_CONF_hadoop_http_staticuser_user=root
# Permisos para la herramienta "Hue" (no la usamos; se deja como el original).
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*
# Tipo de compresion disponible: Snappy (rapido, compresion moderada).
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec


# ---------------------------------------------------------------------
# HDFS (hdfs-site.xml): el sistema de archivos distribuido
# (la replicacion y el latido van en el docker-compose.yml)
# ---------------------------------------------------------------------

# Activa WebHDFS: acceso a HDFS por HTTP (lo usa la web del NameNode para
# navegar por las carpetas en "Utilities > Browse the file system").
HDFS_CONF_dfs_webhdfs_enabled=true
# Desactiva los permisos de usuario de HDFS: cualquiera puede leer/escribir.
# Comodo en un entorno local de practicas; NO se haria en produccion.
HDFS_CONF_dfs_permissions_enabled=false
# No exigir que la IP de cada DataNode coincida con su nombre en un DNS
# (en Docker las IPs cambian cada vez que se recrea un contenedor).
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false
# CAMBIO (nuevo, 18 oct): 2 copias de cada bloque para TODOS los programas que
# escriben en HDFS desde estos contenedores (tambien YARN y las tareas de
# MapReduce). Antes solo lo sabian el NameNode y los DataNodes (lo pone el
# docker-compose.yml), y el ResourceManager escribio sus archivos de /rmstate
# pidiendo 3 copias (el valor por defecto): con solo 2 DataNodes quedaban
# "sub-replicados". Comprobado con "hdfs dfs -ls -R /" el 18 oct.
HDFS_CONF_dfs_replication=2


# ---------------------------------------------------------------------
# YARN (yarn-site.xml): reparte memoria y CPU entre las tareas de MapReduce
# Solo se usa cuando se enciende el perfil "yarn":
#     docker compose --profile yarn up -d
# ---------------------------------------------------------------------

# Guardar los logs de cada job en HDFS (carpeta /app-logs, ver mas abajo)
# para poder leerlos despues con "yarn logs -applicationId ...".
YARN_CONF_yarn_log___aggregation___enable=true
# Direccion web de los logs en el historyserver. NO usamos historyserver
# (se quito el 16 oct para ahorrar RAM): se deja como el original, no molesta.
YARN_CONF_yarn_log_server_url=http://historyserver:8188/applicationhistory/logs/
# Si el ResourceManager se reinicia, recupera los jobs en curso a partir de
# un estado que guarda en HDFS (en la carpeta /rmstate).
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.FileSystemRMStateStore
YARN_CONF_yarn_resourcemanager_fs_state___store_uri=/rmstate
# Planificador de YARN: "CapacityScheduler" (reparte por colas; usamos solo
# la cola "default").
YARN_CONF_yarn_resourcemanager_scheduler_class=org.apache.hadoop.yarn.server.resourcemanager.scheduler.capacity.CapacityScheduler
# CAMBIO: tarea mas grande permitida en la cola "default" 8192 -> 2048 MB
YARN_CONF_yarn_scheduler_capacity_root_default_maximum___allocation___mb=2048
# Nucleos maximos de una tarea en la cola "default" (sin cambios).
YARN_CONF_yarn_scheduler_capacity_root_default_maximum___allocation___vcores=4
# CAMBIO: true -> false (no hay historyserver/timeline al que publicar metricas)
YARN_CONF_yarn_resourcemanager_system___metrics___publisher_enabled=false
# Donde esta el ResourceManager y sus "ventanillas" (puertos):
#   8032 = envio de jobs, 8030 = planificador, 8031 = registro de NodeManagers
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_resourcemanager_address=resourcemanager:8032
YARN_CONF_yarn_resourcemanager_scheduler_address=resourcemanager:8030
YARN_CONF_yarn_resourcemanager_resource__tracker_address=resourcemanager:8031
# CAMBIO: true -> false (el servicio "timeline" necesita el historyserver,
# que se quito el 16 oct para ahorrar RAM)
YARN_CONF_yarn_timeline___service_enabled=false
# Ajustes del "timeline" (sin efecto al estar desactivado arriba).
YARN_CONF_yarn_timeline___service_generic___application___history_enabled=true
YARN_CONF_yarn_timeline___service_hostname=historyserver
# Comprimir con Snappy los resultados intermedios de los map (lo que viaja
# en el shuffle): menos datos por la red y el disco.
YARN_CONF_mapreduce_map_output_compress=true
YARN_CONF_mapred_map_output_compress_codec=org.apache.hadoop.io.compress.SnappyCodec
# CAMBIO: memoria del NodeManager para tareas 16384 -> 2048 MB
YARN_CONF_yarn_nodemanager_resource_memory___mb=2048
# CAMBIO: nucleos para tareas 8 -> 4
YARN_CONF_yarn_nodemanager_resource_cpu___vcores=4
# CAMBIO (nuevo): tamano minimo y maximo de una tarea (por defecto 1024 y 8192 MB)
YARN_CONF_yarn_scheduler_minimum___allocation___mb=256
YARN_CONF_yarn_scheduler_maximum___allocation___mb=2048
# CAMBIO (nuevo): no matar tareas por memoria VIRTUAL (Java 8 reserva mucha sin usarla;
# el control de memoria real sigue activo)
YARN_CONF_yarn_nodemanager_vmem___check___enabled=false
# No marcar el disco como "lleno" hasta el 98,5 % de uso.
YARN_CONF_yarn_nodemanager_disk___health___checker_max___disk___utilization___per___disk___percentage=98.5
# Carpeta de HDFS donde se guardan los logs de los jobs (ver log aggregation).
YARN_CONF_yarn_nodemanager_remote___app___log___dir=/app-logs
# Servicio auxiliar del NodeManager que hace el "shuffle" de MapReduce
# (entregar a cada reduce los resultados de los map que le tocan).
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle


# ---------------------------------------------------------------------
# MAPREDUCE (mapred-site.xml): tamano de cada tarea de un job
# Se usa al lanzar un job (p. ej. Hadoop Streaming en la parte C).
# ---------------------------------------------------------------------

# Ejecutar los jobs de MapReduce sobre YARN (y no en modo "local").
MAPRED_CONF_mapreduce_framework_name=yarn
# CAMBIO: Java de cada tarea -Xmx4096m -> -Xmx384m
MAPRED_CONF_mapred_child_java_opts=-Xmx384m
# CAMBIO: cada tarea map 4096 -> 512 MB
MAPRED_CONF_mapreduce_map_memory_mb=512
# CAMBIO: cada tarea reduce 8192 -> 1024 MB
MAPRED_CONF_mapreduce_reduce_memory_mb=1024
# CAMBIO: Java de cada map -Xmx3072m -> -Xmx384m (deja sitio al proceso Python del mapper)
MAPRED_CONF_mapreduce_map_java_opts=-Xmx384m
# CAMBIO: Java de cada reduce -Xmx6144m -> -Xmx768m
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx768m
# Donde esta instalado Hadoop dentro de los contenedores, para el
# coordinador del job (ApplicationMaster) y para las tareas map y reduce.
MAPRED_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
MAPRED_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1/
# CAMBIO (nuevo): el coordinador de cada job (ApplicationMaster), por defecto 1536 MB -> 512 MB
MAPRED_CONF_yarn_app_mapreduce_am_resource_mb=512
MAPRED_CONF_yarn_app_mapreduce_am_command___opts=-Xmx384m
